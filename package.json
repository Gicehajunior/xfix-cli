{
  "name": "xfix-cli",
  "version": "1.0.0",
  "description": "XFIX CLI - Project Management & Deployment Tool",
  "type": "module",
  "main": "src/app.js",
  "bin": {
    "xfix": "./bin/cli.js"
  },
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=8192 node bin/cli.js",
  
    "deploy": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix run --deploy",
    "deploy:secure": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix run --deploy --secure",
    "deploy:verbose": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix run --deploy --verbose",
  
    "obfuscate": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix obfuscate --all",
    "obfuscate:js": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix obfuscate --js",
    "obfuscate:php": "cross-env NODE_OPTIONS=--max-old-space-size=8192 xfix obfuscate --php",
  
    "dev:controller": "xfix dev generate controller",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "basic-ftp": "^5.0.3",
    "commander": "^11.0.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.10",
    "gulp": "^4.0.2",
    "gulp-javascript-obfuscator": "^1.1.6",
    "ignore": "^5.2.4",
    "mysql2": "^3.22.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.20.0",
    "simple-git": "^3.36.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vinyl-sourcemaps-apply": "^0.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/gulp": "^4.0.17",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "deploy",
    "obfuscate",
    "ftp",
    "cli",
    "xfix"
  ],
  "author": "",
  "license": "ISC"
}
